# Demo previews do not call the image provider. Set live only after configuring
# accounts, an API key, and the intended billing limits.
APP_MODE=demo
OPENAI_API_KEY=

# Required for normal and Docker operation. Replace the blank value with your
# own accounts, for example owner:YOUR_UNIQUE_PASSWORD,designer:ANOTHER_PASSWORD.
# Commas separate users; a password cannot contain a comma.
TEAM_USERS=
# Leave blank to use the first configured account as owner.
ADMIN_USERS=

MAX_WORKERS=3
# Set to 1 behind HTTPS. Leave 0 only for local HTTP development.
COOKIE_SECURE=0
ALLOW_ANONYMOUS_DEMO=0

# New workflow controls. Disable either view/API with 0, then restart.
# Disabling A+ does not cancel accepted jobs. Usage receipts still record live
# requests when the dashboard is disabled.
STUDIOFLOW_ENABLE_APLUS=1
STUDIOFLOW_ENABLE_USAGE=1

# Compose publishes on loopback unless you explicitly opt into network access.
STUDIOFLOW_BIND_ADDRESS=127.0.0.1

# Optional local overrides. Docker sets its own data path and requires accounts.
# STUDIOFLOW_DATA_DIR=C:/path/to/studioflow-data
# STUDIOFLOW_LOAD_DOTENV=0
# STUDIOFLOW_REQUIRE_AUTH=1
