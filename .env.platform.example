# Copy to .env.platform. Keep the existing .env and workspace unchanged.
APP_MODE=demo
OPENAI_API_KEY=
TEAM_USERS=owner:replace-with-a-long-private-password
ADMIN_USERS=owner
COOKIE_SECURE=0
MAX_WORKERS=3
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
DATABASE_URL=postgresql+psycopg://studioflow:replace-with-a-url-safe-database-password@postgres:5432/studioflow
STUDIOFLOW_STORAGE=s3
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=studioflow
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-a-private-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-private-secret
STUDIOFLOW_ENABLE_CREATION=1
STUDIOFLOW_ENABLE_COMPOSITION=1
STUDIOFLOW_ENABLE_EXPORTS=1
# Enable only after a paid provider capability test succeeds for each model.
STUDIOFLOW_VALIDATED_2K_MODELS=
# Use a different host port during rehearsal; the old app can keep port 8000.
STUDIOFLOW_PORT=8001
STUDIOFLOW_NETWORK=studioflow-local-platform
# External backup settings are required before production activation.
RESTIC_REPOSITORY=s3:https://external-s3.example.com/studioflow-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
STUDIOFLOW_BACKUP_HOST=studioflow
STUDIOFLOW_SECRETS_PATH=./.secrets
